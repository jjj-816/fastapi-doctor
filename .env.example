# FastAPI Doctor 本地环境配置（此文件被 .gitignore 忽略，不要提交）。
# 配置了 LLM_API_KEY + LLM_BASE_URL 两项后，build_llm 会自动切换到在线
# OpenAI 兼容接口；两项都留空则回退本地 Ollama（qwen3:0.6b）。

# === 在线 API（三行都改：Key、Base URL、型号名） ===
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 常见服务商示例（去掉行首 # 并填入你的 Key 即可启用）：
# DeepSeek:
#   LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
# 智谱 GLM:
#   LLM_API_KEY=xxxxxxxx.xxxxxxxxxxxxxxxx
#   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   LLM_MODEL=glm-4-flash
# 其他任何 OpenAI 兼容服务同理，Base URL 与型号名看服务商文档。

# === 本地 Ollama（LLM_API_KEY 为空时生效，检索向量始终走本地） ===
OLLAMA_BASE_URL=http://localhost:11434
DENSE_MODEL=nomic-embed-text:latest

# === 单次 LLM 请求超时秒数（默认 300；在线模型偶发慢响应时可调大） ===
# LLM_REQUEST_TIMEOUT=300
